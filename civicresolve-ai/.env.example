# CivicResolve AI Environment Configuration
CIVICRESOLVE_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./civicresolve.db
SECRET_KEY=civicresolve-super-secure-production-secret-dubai-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Configuration (Ollama Local First)
OLLAMA_BASE_URL=http://localhost:11434
PRIMARY_MODEL=qwen2.5:7b-instruct
FALLBACK_MODEL=llama3.1:8b-instruct
USE_MOCK_FALLBACK=true

# Embedding & RAG Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
FAISS_INDEX_PATH=./rag/faiss_index

# External Workflow Integration (n8n Webhook Forms)
N8N_NEW_COMPLAINT_URL=https://askdubai.app.n8n.cloud/form/civicresolve
N8N_UPDATE_CASE_URL=https://askdubai.app.n8n.cloud/form/civicresolve-update

# OCR & Document Processing
TESSERACT_CMD=
MAX_UPLOAD_SIZE_MB=15
